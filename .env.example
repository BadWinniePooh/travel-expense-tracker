# =============================================================================
# Travel Expense Tracker — environment configuration
# =============================================================================
# Copy this file to .env and fill in the values before running docker compose:
#
#   cp .env.example .env
#
# .env is git-ignored and will never be committed.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=travelexpenses
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate a random value for production:
#   openssl rand -base64 48
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_ISSUER=travel-expense-tracker
JWT_AUDIENCE=travel-expense-tracker
JWT_EXPIRY_MINUTES=60

# ── Admin seed account ────────────────────────────────────────────────────────
# Created automatically on first startup if no users exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
ADMIN_EMAIL=admin@example.com

# ── Host ports ────────────────────────────────────────────────────────────────
# Port the frontend is reachable on from the host.
FRONTEND_PORT=3000

# Development profile only — debug ports exposed to the host.
POSTGRES_PORT=5433
BACKEND_PORT=5000

# ── Traefik HTTPS (docker-compose.traefik.yml only) ───────────────────────────
# Public domain routed by your existing Traefik instance.
DOMAIN=travel.example.com
# Docker network that Traefik is attached to (default: traefik).
TRAEFIK_NETWORK=traefik
