# PostgreSQL
POSTGRES_DB=travelexpenses
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme

# ASP.NET Core Backend
ConnectionStrings__DefaultConnection=Host=postgres;Database=travelexpenses;Username=appuser;Password=changeme
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# JWT Configuration (Secret must be at least 32 characters)
Jwt__Secret=change-me-in-production-min-32-chars!!
Jwt__Issuer=travel-expense-tracker
Jwt__Audience=travel-expense-tracker
Jwt__ExpiryMinutes=60

# Default Admin User (created on first startup if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
ADMIN_EMAIL=admin@example.com
